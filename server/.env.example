# ==============================================================================
# Konfigurasi Environment Backend API Posyandu Lansia
# Salin file ini menjadi .env dan sesuaikan nilainya dengan konfigurasi server Anda.
# ==============================================================================

# Port server Express (Default: 8080 atau sesuai alokasi Node.js port di cPanel)
PORT=8080

# Mode environment: 'development' atau 'production'
# Pada mode production, verifikasi CORS aktif dan hanya mengizinkan origin terdaftar
NODE_ENV=production

# URL Frontend klien aplikasi web (tanpa garis miring di akhir)
CLIENT_URL=https://posyandu.example.com

# URL Database MySQL / MariaDB (format: mysql://username:password@host:port/database_name)
DATABASE_URL=mysql://db_user:db_password@localhost:3306/posyandu_db

# Kunci rahasia untuk enkripsi sesi dan token Better Auth (minimal 32 karakter acak yang aman)
BETTER_AUTH_SECRET=ganti_dengan_kunci_rahasia_acak_yang_sangat_kuat_min_32_karakter

# Base URL backend tempat Better Auth berjalan (URL API publik backend Anda)
BETTER_AUTH_URL=https://api.posyandu.example.com

# Daftar domain/origin tambahan yang diizinkan mengakses API melalui CORS
# Pisahkan dengan tanda koma tanpa spasi jika ada lebih dari satu origin
ALLOWED_ORIGINS=https://posyandu.example.com,https://admin.posyandu.example.com
